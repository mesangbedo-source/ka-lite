# Copy this file to deploy/kalite.env and set a strong admin password.
# deploy/kalite.env is ignored by Git and must not be committed.

KALITE_HOME=/data
KALITE_CONTENT_ROOT=/content
KALITE_LISTEN_PORT=8008

KA_LITE_ADMIN_USER=admin
KA_LITE_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_START
KA_LITE_ADMIN_EMAIL=admin@example.invalid

# Optional: a compatible recovered content database.
# Put it at deploy/database/staging/content_khan_en.sqlite or change this path.
SEED_CONTENT_DB=/seed/staging/content_khan_en.sqlite

# Optional: verify the seed database before copying it.
# Leave empty when using a different seed. The historical recovered English
# database used by this maintenance fork has this hash:
# bb2959bbe00f6d81ed76898d7ade36e42aa0bbbbe93d00d919e71e1629899a26
SEED_CONTENT_DB_SHA256=

# 0: annotate local video availability only when a seed is installed.
# 1: rescan CONTENT_ROOT on every start (use after adding videos, then set 0).
KA_LITE_REANNOTATE=0
